[sub_resource type="GDScript" id="GDScript_0j73o"]
resource_name = "dhammah"
script/source = "extends Control

@onready var container_semua = $papanmateri/container_huruf
@onready var container_satu = $papanmateri/center_satu/container_satu
@onready var center_satu = $papanmateri/center_satu
@onready var tombol_mode = $tombolsendiri
@onready var tombol_auto = $auto

var daftar_audio = []
@onready var player = AudioStreamPlayer.new()

# =========================
# DATA
# =========================
var daftar_huruf = []
var index = 0
var mode = 0 # 0 = satu huruf, 1 = semua huruf

# =========================
# AUTO PLAY
# =========================
var auto_jalan = false
var timer_auto


func bunyi_awal_delay():
	await get_tree().create_timer(0.5).timeout  # ⏳ cepat & enak
	
	if mode == 0:
		putar_audio(index)
		
func load_audio():
	for i in range(1, 31):
		var path = \"res://audiofathah/\" + str(i) + \".mp3\"
		var audio = load(path)
		
		if audio:
			daftar_audio.append(audio)
		else:
			print(\"GAGAL LOAD AUDIO:\", path)
		
		
func putar_audio(i):
	if i < daftar_audio.size():
		player.stream = daftar_audio[i]
		player.play()
		


# =========================
# LOAD HURUF
# =========================
func load_huruf():
	for i in range(1, 31):
		var path = \"res://dhammah/\" + str(i) + \".png\"
		var tex = load(path)
		
		if tex:
			daftar_huruf.append(tex)
		else:
			print(\"GAGAL LOAD:\", path)

# =========================
func _ready():
	load_huruf()
	load_audio()
	add_child(player)
	await get_tree().process_frame
	tampil_satu()
	

	timer_auto = Timer.new()
	add_child(timer_auto)
	timer_auto.wait_time = 1.5
	timer_auto.timeout.connect(next_huruf)
	

# =========================
# MODE 1 (SATU - TENGAH BESAR)
# =========================
func tampil_satu():
	container_semua.hide()
	center_satu.show()
	

	hapus_semua_satu()

	var tex = TextureRect.new()
	tex.texture = daftar_huruf[index]

	# ukuran
	tex.custom_minimum_size = Vector2(900, 900)

	tex.expand = true
	tex.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED

	# 🔥 CENTER MANUAL
	tex.anchor_left = 0.5
	tex.anchor_top = 0.5
	tex.anchor_right = 0.5
	tex.anchor_bottom = 0.5

	tex.offset_left = -450
	tex.offset_top = -450
	tex.offset_right = 450
	tex.offset_bottom = 450

	container_satu.add_child(tex)
	putar_audio(index)
	
	animasi_huruf()
	
# =========================
# MODE 2 (SEMUA - GRID)
# =========================
func tampil_semua():
	center_satu.hide()
	container_semua.show()

	hapus_semua_semua()

	container_semua.columns = 5

	for i in range(daftar_huruf.size()):
		var index_huruf = daftar_huruf.size() - i - 1
		var btn = Button.new()
		btn.custom_minimum_size = Vector2(110, 110)
		
		btn.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		btn.size_flags_vertical = Control.SIZE_EXPAND_FILL

		var img = TextureRect.new()
		img.texture = daftar_huruf[i]
		img.expand = true
		img.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
		img.anchor_right = 1
		img.anchor_bottom = 1

		btn.add_child(img)
		var idx = i
		
		btn.pressed.connect(func():
			print(\"Klik huruf ke:\", index_huruf)
			
			index = idx
			mode = 0
			#tampil satu
			tampil_satu()
			
			# ⏳ tunggu 1 detik
			await get_tree().create_timer(1.0).timeout
			
			# balik ke mode semua
			mode = 1
			tampil_semua()
		)
		
		container_semua.add_child(btn)

# =========================
# TOGGLE MODE
# =========================
func _on_tombolsendiri_pressed():
	mode = 1 - mode
	
	print(\"MODE:\", mode)

	if mode == 0:
		tampil_satu()
		$tombollanjut.show()
		$tombollanjut2.show()
	else:
		tampil_semua()
		$tombollanjut.hide()
		$tombollanjut2.hide()

	tombol_mode.update_icon(mode)
	


# =========================
# AUTO PLAY
# =========================
func _on_auto_pressed():
	auto_jalan = !auto_jalan
	
	if auto_jalan:
		timer_auto.start()
	else:
		timer_auto.stop()

# =========================
# NEXT HURUF
# =========================
func next_huruf():
	if mode == 0:
		index += 1
		
		if index >= daftar_huruf.size():
			index = 0
		
		tampil_satu()
		
		 

# =========================
# HAPUS KHUSUS
# =========================
func hapus_semua_satu():
	for child in container_satu.get_children():
		child.queue_free()

func hapus_semua_semua():
	for child in container_semua.get_children():
		child.queue_free()

# =========================
func set_mode(m):
	mode = m
	
	if mode == 0:
		tampil_satu()
	else:
		tampil_semua()
		
		
# =========================
# TOMBOL NEXT
# =========================
func _on_btn_next_pressed():
	if mode == 0:
		index += 1
		
		if index >= daftar_huruf.size():
			index = 0
		
		tampil_satu()

# =========================
# TOMBOL BACK
# =========================
func _on_btn_back_pressed():
	if mode == 0:
		index -= 1
		
		if index < 0:
			index = daftar_huruf.size() - 1
		
		tampil_satu()
		


func _on_tombollanjut_pressed() -> void:
	if mode == 0:
		index += 1
		
		if index >= daftar_huruf.size():
			index = 0
		tampil_satu()
		
		


func _on_tombollanjut_2_pressed() -> void:
	if mode == 0:
		index -= 1
		
		if index < 0:
			index = daftar_huruf.size() - 1
		tampil_satu()
		
		


func _on_kembali_pressed() -> void:
	pass # Replace with function body.
	
func animasi_huruf():
	if container_satu.get_child_count() == 0:
		return
	
	var huruf = container_satu.get_child(0)

	# mulai kecil
	huruf.scale = Vector2(0.8, 0.8)

	var tween = create_tween()
	tween.tween_property(huruf, \"scale\", Vector2(1.1, 1.1), 0.15)
	tween.tween_property(huruf, \"scale\", Vector2(1, 1), 0.15)
"

[sub_resource type="GDScript" id="GDScript_itpew"]
resource_name = "keluar"
script/source = "extends TextureButton


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	connect(\"pressed\", Callable(self, \"_on_button_pressed\")) # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _on_button_pressed() -> void:
	get_tree().change_scene_to_file(\"res://pilih_meteri_belajar.tscn\")
"

[sub_resource type="GDScript" id="GDScript_nl7fx"]
resource_name = "tombolsendiri"
script/source = "extends TextureButton

@export var icon_tombolsendiri : Texture2D
@export var icon_tombolsemua : Texture2D

func _ready():
	update_icon(0)

func update_icon(mode):
	if mode == 0:
		texture_normal = icon_tombolsendiri
	else:
		texture_normal = icon_tombolsemua
"

