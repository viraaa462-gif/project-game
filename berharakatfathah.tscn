[sub_resource type="GDScript" id="GDScript_pk046"]
resource_name = "berharakatfathah"
script/source = "extends Control

@onready var container_semua = $papanmateri/container_huruf
@onready var container_satu = $papanmateri/center_satu/container_satu
@onready var center_satu = $papanmateri/center_satu
@onready var tombol_mode = $tombolsendiri
@onready var tombol_auto = $auto
@onready var audio_sapa = $audiosapa

var daftar_audio = []
@onready var player = AudioStreamPlayer.new()

# =========================
# DATA
# =========================
var daftar_huruf = []
var index = 0
var mode = 0 # 0 = satu huruf, 1 = semua huruf

# =========================
# AUTO PLAY
# =========================
var auto_jalan = false
var timer_auto

# =========================
# LOAD AUDIO
# =========================
func load_audio():
	for i in range(1, 29):
		var path = \"res://audiofathah/\" + str(i) + \".mp3\"
		var audio = load(path)
		
		if audio:
			daftar_audio.append(audio)
		else:
			print(\"GAGAL LOAD AUDIO:\", path)

# =========================
# PUTAR AUDIO + ANIMASI
# =========================
func putar_audio(i, huruf_node = null):
	if i < daftar_audio.size():
		player.stop()
		player.stream = daftar_audio[i]
		player.play()
		
		var durasi = player.stream.get_length()
		
		if huruf_node != null:
			animasi_huruf(huruf_node, durasi)

# =========================
# LOAD HURUF
# =========================
func load_huruf():
	for i in range(1, 29):
		var path = \"res://fathah/\" + str(i) + \".png\"
		var tex = load(path)
		
		if tex:
			daftar_huruf.append(tex)
		else:
			print(\"GAGAL LOAD:\", path)

# =========================
func _ready():
	load_huruf()
	load_audio()
	add_child(player)
	
			# kecilkan musik background
	MusikManager.set_volume(-30)
		# suara pembuka
	audio_sapa.volume_db = 5

	# besarkan audio huruf
	player.volume_db = 8
	
		# TIMER AUTO
	timer_auto = Timer.new()
	add_child(timer_auto)
	timer_auto.wait_time = 2.5
	timer_auto.timeout.connect(next_huruf)

	await get_tree().process_frame
	await putar_audio_pembuka()
	tampil_satu()
	

# =========================
# MODE 1 (SATU)
# =========================
func tampil_satu(play_audio = true):
	container_semua.hide()
	center_satu.show()

	hapus_semua_satu()

	var tex = TextureRect.new()
	tex.texture = daftar_huruf[index]

	tex.custom_minimum_size = Vector2(1200, 1200)
	tex.expand = true
	tex.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED

	# CENTER
	tex.anchor_left = 0.5
	tex.anchor_top = 0.5
	tex.anchor_right = 0.5
	tex.anchor_bottom = 0.5

	tex.offset_left = -500
	tex.offset_top = -580
	tex.offset_right = 500
	tex.offset_bottom = 420

	container_satu.add_child(tex)

	# 🔥 AUDIO + ANIMASI SINKRON
	if play_audio:
		putar_audio(index, tex)

# =========================
# MODE 2 (SEMUA)
# =========================
func tampil_semua():
	center_satu.hide()
	container_semua.show()

	hapus_semua_semua()

	container_semua.columns = 5

	for i in range(daftar_huruf.size()):
		var index_huruf = daftar_huruf.size() - i - 1
		
		var btn = Button.new()
		btn.custom_minimum_size = Vector2(110, 110)
		btn.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		btn.size_flags_vertical = Control.SIZE_EXPAND_FILL

		var img = TextureRect.new()
		img.texture = daftar_huruf[i]
		img.expand = true
		img.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
		img.anchor_right = 1
		img.anchor_bottom = 1

		btn.add_child(img)
		var idx = i
		
		btn.pressed.connect(func():
			index = idx
			mode = 0
			
			tampil_satu()
			var durasi = daftar_audio[idx].get_length()
			await get_tree().create_timer(durasi).timeout
			
			mode = 1
			tampil_semua()
		)
		
		container_semua.add_child(btn)

# =========================
# TOGGLE MODE
# =========================
func _on_tombolsendiri_pressed():
	# MATIKAN AUTO SAAT GANTI MODE
	auto_jalan = false
	mode = 1 - mode

	if mode == 0:
		tampil_satu()
		$tombollanjut.show()
		$tombollanjut2.show()
	else:
		tampil_semua()
		$tombollanjut.hide()
		$tombollanjut2.hide()

	if tombol_mode:
		tombol_mode.update_icon(mode)

# =========================
# AUTO PLAY
# =========================
func _on_auto_pressed():
	auto_jalan = !auto_jalan
	
	if auto_jalan:
		timer_auto.start()
	else:
		timer_auto.stop()

# =========================
# NEXT HURUF
# =========================
func next_huruf():
	if mode == 0:
		index += 1
		
		if index >= daftar_huruf.size():
			index = 0
		
		tampil_satu()

# =========================
# HAPUS
# =========================
func hapus_semua_satu():
	for child in container_satu.get_children():
		child.queue_free()

func hapus_semua_semua():
	for child in container_semua.get_children():
		child.queue_free()

# =========================
func set_mode(m):
	mode = m
	
	if mode == 0:
		tampil_satu()
	else:
		tampil_semua()

# =========================
# NAVIGASI
# =========================
func _on_btn_next_pressed():
	if mode == 0:
		index += 1
		if index >= daftar_huruf.size():
			index = 0
		tampil_satu()

func _on_btn_back_pressed():
	if mode == 0:
		index -= 1
		if index < 0:
			index = daftar_huruf.size() - 1
		tampil_satu()

func _on_tombollanjut_pressed():
	_on_btn_next_pressed()

func _on_tombollanjut_2_pressed():
	_on_btn_back_pressed()

func _on_kembali_pressed():
	pass

# =========================
# ANIMASI (SINKRON AUDIO)
# =========================
func animasi_huruf(huruf, durasi):
	if huruf == null:
		return

	huruf.scale = Vector2(0.9, 0.9)

	var tween = create_tween()
	var step = durasi / 4.0
	
	tween.tween_property(huruf, \"scale\", Vector2(1.15, 1.15), durasi * 0.5)
	tween.tween_property(huruf, \"scale\", Vector2(1, 1), durasi * 0.5)

func putar_audio_pembuka():

	audio_sapa.stream = load(
		\"res://audiosapaharakat/pembuka.mp3\"
	)

	audio_sapa.play()

	await audio_sapa.finished

	tampil_satu()
"

[sub_resource type="GDScript" id="GDScript_cu3l6"]
resource_name = "kembali"
script/source = "extends TextureButton

@export var icon_tombolsendiri : Texture2D
@export var icon_tombolsemua : Texture2D

func _ready():
	update_icon(0)

func update_icon(mode):
	if mode == 0:
		texture_normal = icon_tombolsendiri
	else:
		texture_normal = icon_tombolsemua
"

[sub_resource type="GDScript" id="GDScript_02cde"]
resource_name = "btn_keluar"
script/source = "extends TextureButton


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	connect(\"pressed\", Callable(self, \"_on_button_pressed\")) # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _on_button_pressed() -> void:
	get_tree().change_scene_to_file(\"res://pilih_meteri_belajar.tscn\")
"

