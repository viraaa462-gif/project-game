[sub_resource type="GDScript" id="GDScript_4c5q6"]
resource_name = "papandragdrop"
script/source = "extends TextureRect

@onready var area_target = $Control/outline
@onready var area_pilihan = $Control/warna

@onready var audiopopup = $\"../audiopopup\"
@onready var popup = $popup
@onready var popupakhir = $\"../popupakhir\"

@onready var btnselesai = $\"../popupakhir/btnselesai\"
@onready var btnmainlagi = $\"../popupakhir/btnmainlagi\"
@onready var star_container = $\"../popupakhir/HBoxContainer\"

@onready var bintang1 = $\"../popupakhir/HBoxContainer/bintang1\"
@onready var bintang2 = $\"../popupakhir/HBoxContainer/bintang2\"
@onready var bintang3 = $\"../popupakhir/HBoxContainer/bintang3\"
var total_salah = 0
var rng = RandomNumberGenerator.new()

var popup_akhir_list = [
	\"res://popupakhir/popupluarbiasa.png\",
	\"res://popupakhir/popuppintarsekali.png\",
	\"res://popupakhir/popupwahhebat.png\"
]

var popup_list = [
	\"res://popupdragdrop/popuppandaluarbiasa.png\",
	\"res://popupdragdrop/popupkelincihebat.png\",
	\"res://popupdragdrop/popupkucingkamupintar.png\"
]

var popup_audio = {
	\"res://popupdragdrop/popuppandaluarbiasa.png\": \"res://audiodragdrop/luarbiasa.mp3\",
	\"res://popupdragdrop/popupkelincihebat.png\": \"res://audiodragdrop/hebatt.mp3\",
	\"res://popupdragdrop/popupkucingkamupintar.png\": \"res://audiodragdrop/kamupintar.mp3\"
}

# 🔥 FIX ERROR DI SINI
var last_popup = \"\"

# 🧠 SEMUA SOAL
var semua_soal = [
	[2, 4, 7],
	[6, 8, 12],
	[9, 13, 14],
	[18, 21, 24],
	[15, 10, 20],
	[1, 3, 5],
	[26, 30, 17],
	[11, 16, 19],
	[22, 23,25],
	[27, 28, 29]
]

var daftar_soal = []
var index_soal = 0
var soal_sebelumnya = []

# 🎯 DRAG SYSTEM
var dragged_item = null
var total_benar = 0
var total_target = 3


# 🎨 LOAD GAMBAR
func get_warna(id):
	return load(\"res://hurufdragdrop/warna/\" + str(id) + \".png\")

func get_outline(id):
	return load(\"res://hurufdragdrop/outline/\" + str(id) + \".png\")

# 🎲 AMBIL 4 SOAL
func ambil_5_soal():

	index_soal = 0
	daftar_soal.clear()

	var temp = semua_soal.duplicate(true)

	# acak berkali-kali
	for i in range(20):
		temp.shuffle()

	# ambil 5 soal baru
	for soal in temp:

		# jangan pakai soal yang sama dengan sebelumnya
		if soal not in soal_sebelumnya:
			daftar_soal.append(soal)

		# kalau sudah 5 stop
		if daftar_soal.size() >= 5:
			break

	# kalau kurang dari 5 (cadangan)
	while daftar_soal.size() < 5:
		var random_soal = semua_soal.pick_random()

		if random_soal not in daftar_soal:
			daftar_soal.append(random_soal)

	# simpan soal sekarang
	soal_sebelumnya = daftar_soal.duplicate(true)

	# acak urutan lagi
	daftar_soal.shuffle()

	print(\"SOAL BARU:\")
	print(daftar_soal)# 🎮 TAMPILKAN SOAL
func tampilkan_soal():
	total_benar = 0
	
	for c in area_target.get_children():
		c.queue_free()

	for c in area_pilihan.get_children():
		c.queue_free()

	var soal = daftar_soal[index_soal]

	# 🔝 TARGET
	var target = soal.duplicate()
	target.shuffle()

	for id in target:
		var slot = TextureRect.new()
		slot.texture = get_outline(id)
		slot.custom_minimum_size = Vector2(150,150)
		slot.expand = true
		slot.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
		slot.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		slot.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
		
		slot.set_meta(\"id\", id)
		area_target.add_child(slot)

	# 🔽 PILIHAN
	var pilihan = soal.duplicate()
	pilihan.shuffle()
	
	while pilihan == target:
		pilihan.shuffle()

	for id in pilihan:
		var item = TextureRect.new()
		item.texture = get_warna(id)
		item.custom_minimum_size = Vector2(150,150)
		item.expand = true
		item.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
		item.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		item.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
		
		item.set_meta(\"id\", id)
		item.mouse_filter = Control.MOUSE_FILTER_STOP
		
		item.gui_input.connect(_on_item_input.bind(item))
		
		area_pilihan.add_child(item)
		
		await get_tree().process_frame
		item.set_meta(\"start_pos\", item.global_position)


# 🖱️ DRAG START
func _on_item_input(event, item):
	if event is InputEventMouseButton and event.pressed:
		dragged_item = item


# 🖱️ DRAG + DROP
func _input(event):
	if dragged_item and event is InputEventMouseMotion:
		dragged_item.global_position = get_global_mouse_position()

	if event is InputEventMouseButton and not event.pressed:
		if dragged_item:
			cek_drop(dragged_item)
			dragged_item = null


# 🎯 CEK DROP
func cek_drop(item):
	for slot in area_target.get_children():
		var jarak = item.global_position.distance_to(slot.global_position)
		
		if jarak < 100:
			if item.get_meta(\"id\") == slot.get_meta(\"id\"):
				item.global_position = slot.global_position
				item.mouse_filter = Control.MOUSE_FILTER_IGNORE
				
				total_benar += 1
				
				if total_benar == total_target:
					await efek_selesai()
			else:
				total_salah += 1
				reset_posisi(item)
			
			return
	
	reset_posisi(item)


func efek_selesai():
	# ⏳ jeda dulu
	await get_tree().create_timer(0.3).timeout
	
	# 🎭 huruf hilang + popup muncul bersamaan
	for c in area_target.get_children():
		c.visible = false

	for c in area_pilihan.get_children():
		c.visible = false
	
	muncul_popup()
	
# 🔄 RESET
func reset_posisi(item):
	item.global_position = item.get_meta(\"start_pos\")


# 🎉 POPUP RANDOM
func muncul_popup():
	# 🔥 SEMBUNYIKAN SEMUA HURUF
	for c in area_target.get_children():
		c.visible = false

	for c in area_pilihan.get_children():
		c.visible = false

	# 🎲 RANDOM POPUP
	var random_popup = popup_list.pick_random()

	while random_popup == last_popup:
		random_popup = popup_list.pick_random()

	last_popup = random_popup

	# 🎭 TAMPILKAN POPUP
	popup.texture = load(random_popup)
	popup.visible = true

	# 🔊 AUDIO SESUAI POPUP
	if popup_audio.has(random_popup):
		audiopopup.stream = load(popup_audio[random_popup])
		audiopopup.stop()
		audiopopup.play()

	# ⏳ TUNGGU
	await get_tree().create_timer(1.5).timeout

	popup.visible = false

	next_soal()

# 🔁 NEXT SOAL
func next_soal():
	index_soal += 1
	
	if index_soal < daftar_soal.size():
		tampilkan_soal()
	else:
		muncul_popup_akhir() #memanggilpopupakhir

func _ready():

	rng.randomize()

	if popup == null:
		print(\"ERROR: node popup tidak ketemu.\")
		return

	if popupakhir == null:
		print(\"ERROR: node popupakhir tidak ketemu.\")
		return

	if btnselesai == null:
		print(\"ERROR: btnselesai tidak ketemu.\")
		return

	# =========================
	# POPUP TENGAH
	# =========================
	popup.anchor_left = 0.5
	popup.anchor_right = 0.5
	popup.anchor_top = 0.5
	popup.anchor_bottom = 0.5

	popup.offset_left = -150
	popup.offset_right = 150
	popup.offset_top = -150
	popup.offset_bottom = 150

	popup.pivot_offset = Vector2(150, 150)

	popup.visible = false
	popup.custom_minimum_size = Vector2(500, 500)
	popup.expand = true
	popup.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED

	# =========================
	# POPUP AKHIR
	# =========================
	popupakhir.anchor_left = 0.5
	popupakhir.anchor_right = 0.5
	popupakhir.anchor_top = 0.5
	popupakhir.anchor_bottom = 0.5

	popupakhir.offset_left = -250
	popupakhir.offset_right = 250
	popupakhir.offset_top = -220
	popupakhir.offset_bottom = 300

	popupakhir.expand = true
	popupakhir.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	popupakhir.mouse_filter = Control.MOUSE_FILTER_IGNORE
	popupakhir.visible = false
	popupakhir.z_index = 20

	# =========================
	# TOMBOL SELESAI
	# =========================
	btnselesai.position = Vector2(60, 330)
	btnselesai.scale = Vector2(0.25, 0.25)

	btnselesai.texture_normal = load(\"res://ui/tombolselesai.png\")
	btnselesai.ignore_texture_size = true

	btnselesai.visible = false
	btnselesai.z_index = 22

	btnselesai.mouse_filter = Control.MOUSE_FILTER_STOP
	btnselesai.disabled = false

	# =========================
	# TOMBOL MAIN LAGI
	# =========================
	btnmainlagi.position = Vector2(270, 330)
	btnmainlagi.scale = Vector2(0.3, 0.3)

	btnmainlagi.texture_normal = load(\"res://ui/mainlagi.png\")
	btnmainlagi.ignore_texture_size = true

	btnmainlagi.visible = false
	btnmainlagi.z_index = 22

	btnmainlagi.mouse_filter = Control.MOUSE_FILTER_STOP
	btnmainlagi.disabled = false

	# =========================
	# BINTANG
	# =========================
	star_container.visible = true
	star_container.z_index = 25

	star_container.position = Vector2(75, 95)
	star_container.size = Vector2(320, 80)

	star_container.add_theme_constant_override(\"separation\", 10)
	star_container.alignment = BoxContainer.ALIGNMENT_CENTER

	bintang1.custom_minimum_size = Vector2(120, 120)
	bintang2.custom_minimum_size = Vector2(120, 120)
	bintang3.custom_minimum_size = Vector2(120, 120)

	bintang1.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	bintang2.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	bintang3.expand_mode = TextureRect.EXPAND_IGNORE_SIZE

	bintang1.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	bintang2.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	bintang3.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED

	bintang1.texture = load(\"res://ui/bintang.png\")
	bintang2.texture = load(\"res://ui/bintang.png\")
	bintang3.texture = load(\"res://ui/bintang.png\")

	bintang1.visible = false
	bintang2.visible = false
	bintang3.visible = false

	# =========================
	# RESET
	# =========================
	total_salah = 0

	ambil_5_soal()
	tampilkan_soal()

	print(area_target)
	print(area_pilihan)
	
func muncul_popup_akhir():
	modulate.a = 0

	# 🔥 SEMBUNYIKAN PAPAN MAIN SAJA
	area_target.visible = false
	area_pilihan.visible = false

	# 🔥 MATIKAN INPUT DRAG
	set_process_input(false)

	var random_popup = popup_akhir_list.pick_random()

	popupakhir.texture = load(random_popup)
	popupakhir.visible = true

	# 🔥 TOMBOL MUNCUL
	btnselesai.visible = true
	btnmainlagi.visible = true

	# 🔥 TOMBOL AKTIF
	btnselesai.disabled = false
	btnmainlagi.disabled = false

	# 🔥 PASTIKAN BISA DIKLIK
	btnselesai.mouse_filter = Control.MOUSE_FILTER_STOP
	btnmainlagi.mouse_filter = Control.MOUSE_FILTER_STOP

	# 🔥 LAYER PALING ATAS
	popupakhir.z_index = 100
	btnselesai.z_index = 101
	btnmainlagi.z_index = 101

	# ⭐ RESET BINTANG
	bintang1.visible = false
	bintang2.visible = false
	bintang3.visible = false

	var jumlah = hitung_bintang()
	await tampilkan_bintang_satu_persatu(jumlah)
	
func tampilkan_bintang_satu_persatu(jumlah):
	var daftar_bintang = [bintang1, bintang2, bintang3]

	for i in range(jumlah):
		await get_tree().create_timer(0.4).timeout
		daftar_bintang[i].visible = true


func hitung_bintang():
	if total_salah == 0:
		return 3
	elif total_salah <= 2:
		return 2
	else:
		return 1
"

[sub_resource type="GDScript" id="GDScript_kwt4v"]
resource_name = "popupkahir"
script/source = "extends TextureRect

@onready var btnselesai = $btnselesai
@onready var btnmainlagi = $btnmainlagi

func _ready():

	mouse_filter = Control.MOUSE_FILTER_STOP

	btnselesai.mouse_filter = Control.MOUSE_FILTER_STOP
	btnmainlagi.mouse_filter = Control.MOUSE_FILTER_STOP

	btnselesai.disabled = false
	btnmainlagi.disabled = false


func _on_btnselesai_pressed():
	print(\"SELESAI DIKLIK\")
	get_tree().change_scene_to_file(\"res://pilihpermainan.tscn\")


func _on_btnmainlagi_pressed():

	# 🔥 TUTUP POPUP
	popupakhir.visible = false

	btnselesai.visible = false
	btnmainlagi.visible = false

	# 🔥 TAMPILKAN PAPAN MAIN
	area_target.visible = true
	area_pilihan.visible = true

	# 🔥 HIDUPKAN INPUT LAGI
	set_process_input(true)

	# 🔥 KEMBALIKAN PAPAN
	modulate.a = 1

	# 🔥 RESET
	total_salah = 0

	# 🔥 AMBIL 5 SOAL RANDOM BARU
	ambil_5_soal()

	# 🔥 TAMPILKAN SOAL PERTAMA
	tampilkan_soal()
"

[sub_resource type="GDScript" id="GDScript_jdp21"]
resource_name = "btn_keluar"
script/source = "extends TextureButton


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	connect(\"pressed\", Callable(self, \"_on_button_pressed\")) # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _on_button_pressed() -> void:
	get_tree().change_scene_to_file(\"res://menu_utama.tscn\")
"

