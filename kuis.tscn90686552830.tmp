# =====================================================
# READY
# =====================================================

func _ready():

	randomize()
	
	# =================================================
# WARNA TEKS PERTANYAAN
# =================================================

	label_pertanyaan.add_theme_color_override(
		\"font_color\",
		Color(\"000000ff\")
	)

	label_pertanyaan.add_theme_color_override(
		\"font_outline_color\",
		Color.WHITE
	)

	label_pertanyaan.add_theme_constant_override(
		\"outline_size\",
		8
	)

	lbl_skor.text = \"0\"
	popuphasilkuis.visible = false

	# =================================================
	# POSISI BALON
	# =================================================

	jawaban1.global_position = Vector2(290, 150)
	jawaban2.global_position = Vector2(490, 110)
	jawaban3.global_position = Vector2(690, 150)

	# =================================================
	# UKURAN BALON
	# =================================================

	jawaban1.scale = Vector2(1.75, 1.75)
	jawaban2.scale = Vector2(1.75, 1.75)
	jawaban3.scale = Vector2(1.75, 1.75)

	# POSISI AWAL ANIMASI
	pos_awal_1 = jawaban1.global_position
	pos_awal_2 = jawaban2.global_position
	pos_awal_3 = jawaban3.global_position

	
	# =================================================
	# KLIK JAWABAN
	# =================================================

	jawaban1.pressed.connect(
	func():
		cek_jawaban(jawaban1, jawaban1.texture_normal.resource_path)
)

	jawaban2.pressed.connect(
	func():
		cek_jawaban(jawaban2, jawaban2.texture_normal.resource_path)
)

	jawaban3.pressed.connect(
	func():
		cek_jawaban(jawaban3, jawaban3.texture_normal.resource_path)
)

	ambil_soal()
	
	btn_selesai.pressed.connect(
		func():
			get_tree().change_scene_to_file(\"res://menuutama.tscn\")
	)

# =====================================================
# ANIMASI BALON RANDOM
# =====================================================

func _process(delta):

	waktu += delta
	
		# TIMER BERMAIN
	waktu_main += delta

	var menit = int(waktu_main) / 60
	var detik = int(waktu_main) % 60

	lbl_waktu.text = \"%02d:%02d\" % [menit, detik]

	jawaban1.position.y = pos_awal_1.y + sin(waktu * 2.0) * 5

	jawaban2.position.y = pos_awal_2.y + sin((waktu + 1.5) * 2.0) * 5

	jawaban3.position.y = pos_awal_3.y + sin((waktu + 3.0) * 2.0) * 5


# =====================================================
# ANIMASI TEKAN
# =====================================================

func animasi_tekan(tombol):
	pass


# =====================================================
# AMBIL SOAL
# =====================================================

func ambil_soal():

	if soal_ke >= total_soal:
		var menit = int(waktu_main) / 60
		var detik = int(waktu_main) % 60
		
			# munculkan popup
		popuphasilkuis.visible = true

		# random popup
		bg_popup.texture = daftar_popup.pick_random()

		# tampilkan score
		lbl_skor_popup.text = str(skor)

		# tampilkan waktu
		lbl_waktu_popup.text = \"%02d:%02d\" % [menit, detik]

		# animasi popup
		popuphasilkuis.scale = Vector2(0,0)

		var tween = create_tween()

		tween.tween_property(
			popuphasilkuis,
			\"scale\",
			Vector2(1,1),
			0.4
		).set_trans(Tween.TRANS_BACK)

		print(\"Kuis selesai\")
		print(\"Score :\", skor)
		print(\"Waktu :\", \"%02d:%02d\" % [menit, detik])

		print(\"Kuis selesai\")
		return

	soal_ke += 1

	soal_aktif = daftar_soal.pick_random()

	label_pertanyaan.text = str(soal_aktif[\"pertanyaan\"])

	var pilihan = soal_aktif[\"pilihan\"].duplicate()

	pilihan.shuffle()

	jawaban1.texture_normal = load(pilihan[0])
	jawaban2.texture_normal = load(pilihan[1])
	jawaban3.texture_normal = load(pilihan[2])

	bisa_jawab = true

# =====================================================
# CEK JAWABAN
# =====================================================

func cek_jawaban(tombol, jawaban_dipilih):

	if bisa_jawab == false:
		return

	# =========================
	# JAWABAN BENAR
	# =========================

	if jawaban_dipilih == soal_aktif[\"benar\"]:

		bisa_jawab = false

		skor += 20
		lbl_skor.text = \"\" + str(skor)

		print(\"Benar\")

		# RESET JUMLAH SALAH
		salah_count = 0

		# MATIKAN GERAK BALON
		set_process(false)

		# EFEK BALON TERBANG
		var tween = create_tween()

		tween.parallel().tween_property(
			tombol,
			\"global_position:y\",
			tombol.global_position.y - 300,
			0.8
		)

		tween.parallel().tween_property(
			tombol,
			\"modulate:a\",
			0.0,
			0.8
		)

		await tween.finished

		await get_tree().create_timer(1.0).timeout

		# KEMBALIKAN BALON
		jawaban1.modulate.a = 1
		jawaban2.modulate.a = 1
		jawaban3.modulate.a = 1

		jawaban1.global_position = pos_awal_1
		jawaban2.global_position = pos_awal_2
		jawaban3.global_position = pos_awal_3

		# HIDUPKAN LAGI GERAK BALON
		set_process(true)

		ambil_soal()

	# =========================
	# JAWABAN SALAH
	# =========================

	else:
		# EFEK GOYANG BALON SALAH
		var tween_salah = create_tween()

		tween_salah.tween_property(
			tombol,
			\"rotation_degrees\",
			-10,
			0.08
		)

		tween_salah.tween_property(
			tombol,
			\"rotation_degrees\",
			10,
			0.08
		)

		tween_salah.tween_property(
			tombol,
			\"rotation_degrees\",
			-10,
			0.08
		)

		tween_salah.tween_property(
			tombol,
			\"rotation_degrees\",
			0,
			0.08
		)

		salah_count += 1

		print(\"Salah ke-\", salah_count)

		# MASIH BOLEH MENCOBA
		if salah_count < 3:

			print(\"Coba lagi\")

		# SUDAH 3 KALI SALAH
		else:

			print(\"Pindah soal\")

			salah_count = 0

			await get_tree().create_timer(1.0).timeout

			ambil_soal()
			
"

[sub_resource type="GDScript" id="GDScript_bb7ij"]
resource_name = "btn_keluar"
script/source = "extends TextureButton


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	connect(\"pressed\", Callable(self, \"_on_button_pressed\")) # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _on_button_pressed() -> void:
	get_tree().change_scene_to_file(\"res://menu_utama.tscn\")
"

