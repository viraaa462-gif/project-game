[sub_resource type="GDScript" id="GDScript_wfqk7"]
resource_name = "materitanpaharakat"
script/source = "extends Control

@onready var container_semua = $papanmateri/container_huruf
@onready var container_satu = $papanmateri/center_satu/container_satu
@onready var center_satu = $papanmateri/center_satu
@onready var tombol_mode = $tombolsendiri
@onready var tombol_auto = $auto

var daftar_audio = []
@onready var player = AudioStreamPlayer.new()

# =========================
# DATA
# =========================
var daftar_huruf = []
var index = 0
var mode = 0 # 0 = satu huruf, 1 = semua huruf

# =========================
# AUTO PLAY
# =========================
var auto_jalan = false
var durasi_audio_sekarang = 1.0
var jeda = 0.5 # jeda antar huruf

# =========================
# LOAD AUDIO
# =========================
func load_audio():
	for i in range(1, 31):
		var path = \"res://audiohurufdasar/\" + str(i) + \".mp3\"
		var audio = load(path)
		
		if audio:
			daftar_audio.append(audio)
		else:
			print(\"GAGAL LOAD AUDIO:\", path)

# =========================
# PUTAR AUDIO + ANIMASI
# =========================
func putar_audio(i, huruf_node = null):
	if i < daftar_audio.size():
		player.stop()
		player.stream = daftar_audio[i]
		player.play()
		
		durasi_audio_sekarang = player.stream.get_length()
		
		if huruf_node != null:
			animasi_huruf(huruf_node, durasi_audio_sekarang)

# =========================
# LOAD HURUF
# =========================
func load_huruf():
	for i in range(1, 31):
		var path = \"res://huruftanpaharakat/\" + str(i) + \".png\"
		var tex = load(path)
		
		if tex:
			daftar_huruf.append(tex)
		else:
			print(\"GAGAL LOAD:\", path)

# =========================
func _ready():
	load_huruf()
	load_audio()
	add_child(player)
	MusikManager.set_volume(-27)
	player.volume_db = 8
	await get_tree().process_frame
	tampil_satu()

# =========================
# MODE 1 (SATU)
# =========================
func tampil_satu():
	container_semua.hide()
	center_satu.show()

	hapus_semua_satu()

	var tex = TextureRect.new()
	tex.texture = daftar_huruf[index]

	tex.custom_minimum_size = Vector2(1300, 1300)
	tex.expand = true
	tex.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED

	# CENTER
	tex.anchor_left = 0.5
	tex.anchor_top = 0.5
	tex.anchor_right = 0.5
	tex.anchor_bottom = 0.5

	tex.offset_left = -550
	tex.offset_top = -700
	tex.offset_right = 550
	tex.offset_bottom = 400

	container_satu.add_child(tex)

	# AUDIO + ANIMASI
	putar_audio(index, tex)

# =========================
# MODE 2 (SEMUA)
# =========================
func tampil_semua():
	center_satu.hide()
	container_semua.show()

	hapus_semua_semua()

	container_semua.columns = 5
	container_semua.add_theme_constant_override(\"h_separation\", 5)
	container_semua.add_theme_constant_override(\"v_separation\", 5)

	for i in range(daftar_huruf.size()):
		var btn = Button.new()
		btn.custom_minimum_size = Vector2(90, 90)
		btn.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		btn.size_flags_vertical = Control.SIZE_EXPAND_FILL

		var img = TextureRect.new()
		img.texture = daftar_huruf[i]
		img.expand = true
		img.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
		img.anchor_right = 1
		img.anchor_bottom = 1

		btn.add_child(img)
		var idx = i
		
		btn.pressed.connect(func():
			index = idx
			mode = 0
			
			tampil_satu()
			
			# tunggu sesuai durasi audio
			await get_tree().create_timer(durasi_audio_sekarang + 0.2).timeout
			
			mode = 1
			tampil_semua()
		)
		
		container_semua.add_child(btn)

# =========================
# TOGGLE MODE
# =========================
func _on_tombolsendiri_pressed():
	# MATIKAN AUTO SAAT GANTI MODE
	auto_jalan = false
	mode = 1 - mode

	if mode == 0:
		tampil_satu()
		$tombollanjut.show()
		$tombollanjut2.show()
	else:
		tampil_semua()
		$tombollanjut.hide()
		$tombollanjut2.hide()

	tombol_mode.update_icon(mode)

# =========================
# AUTO PLAY (IKUT AUDIO)
# =========================
func _on_auto_pressed():
	auto_jalan = !auto_jalan
	
	if auto_jalan:
		auto_loop()

func auto_loop():
	while auto_jalan:
		tampil_satu()
		
		await get_tree().create_timer(durasi_audio_sekarang + jeda).timeout
		
		index += 1
		if index >= daftar_huruf.size():
			index = 0

# =========================
# HAPUS
# =========================
func hapus_semua_satu():
	for child in container_satu.get_children():
		child.queue_free()

func hapus_semua_semua():
	for child in container_semua.get_children():
		child.queue_free()

# =========================
func set_mode(m):
	mode = m
	
	if mode == 0:
		tampil_satu()
	else:
		tampil_semua()

# =========================
# NAVIGASI
# =========================
func _on_btn_next_pressed():
	if mode == 0:
		index += 1
		if index >= daftar_huruf.size():
			index = 0
		tampil_satu()

func _on_btn_back_pressed():
	if mode == 0:
		index -= 1
		if index < 0:
			index = daftar_huruf.size() - 1
		tampil_satu()

func _on_tombollanjut_pressed():
	_on_btn_next_pressed()

func _on_tombollanjut_2_pressed():
	_on_btn_back_pressed()

func _on_kembali_pressed():
	pass

# =========================
# ANIMASI (SUDAH DISTABILKAN)
# =========================
func animasi_huruf(huruf, durasi):
	if huruf == null:
		return

	# 🔥 BATAS BIAR ENAK DILIHAT
	var durasi_min = 0.6
	var durasi_max = 2.0
	
	var durasi_fix = clamp(durasi, durasi_min, durasi_max)

	huruf.scale = Vector2(0.9, 0.9)

	var tween = create_tween()

	var step = durasi_fix / 5.0

	tween.tween_property(huruf, \"scale\", Vector2(1.1, 1.1), step)
	tween.tween_interval(step) # tahan sebentar
	tween.tween_property(huruf, \"scale\", Vector2(1, 1), step)
	tween.tween_property(huruf, \"scale\", Vector2(1.05, 1.05), step)
	tween.tween_property(huruf, \"scale\", Vector2(1, 1), step)
"

[sub_resource type="GDScript" id="GDScript_mn8s5"]
resource_name = "kembali"
script/source = "extends TextureButton


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	connect(\"pressed\", Callable(self, \"_on_button_pressed\")) # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _on_button_pressed() -> void:
	get_tree().change_scene_to_file(\"res://halmateri.tscn\")
"

[sub_resource type="GDScript" id="GDScript_xqvoi"]
resource_name = "tombolsendiri"
script/source = "extends TextureButton

@export var icon_tombolsendiri : Texture2D
@export var icon_tombolsemua : Texture2D

func _ready():
	update_icon(0)

func update_icon(mode):
	if mode == 0:
		texture_normal = icon_tombolsendiri
	else:
		texture_normal = icon_tombolsemua
"

