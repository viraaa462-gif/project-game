[sub_resource type="GDScript" id="GDScript_acbcq"]
script/source = "extends Control

@onready var btn_belajar = $ui_menu/tombol_menu/slot_belajar/belajar
@onready var btn_bermain = $ui_menu/tombol_menu/slot_bermain/bermain
@onready var btn_kuis = $ui_menu/tombol_menu/slot_kuis/kuis

@onready var popup_keluar = $CanvasLayer/popupkeluar
@onready var bg_popup = $CanvasLayer/popupkeluar/popup

func _on_btn_keluar_pressed():
	get_tree().quit()


func _on_btn_batal_pressed():

	popup_keluar.hide()

	btn_belajar.show()
	btn_bermain.show()
	btn_kuis.show()


func buka_popup():

	popup_keluar.show()

	# posisi manual
	bg_popup.position = Vector2(200, 100)

	btn_belajar.hide()
	btn_bermain.hide()
	btn_kuis.hide()
"

[sub_resource type="GDScript" id="GDScript_fglmo"]
resource_name = "btn_close"
script/source = "extends TextureButton

func _pressed():
	get_tree().current_scene.buka_popup()
"

[sub_resource type="GDScript" id="GDScript_8vw10"]
resource_name = "informasi"
script/source = "extends TextureButton

func _ready() -> void:
	pass

func _process(delta: float) -> void:
	pass

func _pressed():
	get_tree().change_scene_to_file(\"res://informasi.tscn\")
"

[sub_resource type="GDScript" id="GDScript_ncqx8"]
resource_name = "musik"
script/source = "extends TextureButton

@export var icon_on : Texture2D
@export var icon_off : Texture2D

func _ready():
	update_icon()

func _pressed():
	MusikManager.toggle_music()
	update_icon()

func update_icon():
	if MusikManager.is_muted:
		texture_normal = icon_off
	else:
		texture_normal = icon_on
"

