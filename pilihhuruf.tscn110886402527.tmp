var semua_soal = []


# =========================
# READY
# =========================

func _ready():

	randomize()

	# simpan posisi awal
# simpan posisi baru
	posisi_awal_tombol[jawaban1] = Vector2(300, 10)
	posisi_awal_tombol[jawaban2] = Vector2(610, 10)
	posisi_awal_tombol[jawaban3] = Vector2(920, 10)
			
	jawaban1.scale = Vector2(0.8, 0.8)
	jawaban2.scale = Vector2(0.8, 0.8)
	jawaban3.scale = Vector2(0.8, 0.8)


	# acak semua soal
	soal_fathah.shuffle()

	# ambil 5 soal
	soal_aktif = soal_fathah.slice(0, 5)

	# connect tombol
	jawaban1.pressed.connect(func():
		cek_jawaban(jawaban1)
	)

	jawaban2.pressed.connect(func():
		cek_jawaban(jawaban2)
	)

	jawaban3.pressed.connect(func():
		cek_jawaban(jawaban3)
	)

	# animasi goyang
	animasi_goyang(jawaban1)
	animasi_goyang(jawaban2)
	animasi_goyang(jawaban3)

	tampilkan_soal()

# =========================
# TAMPILKAN SOAL
# =========================

func tampilkan_soal():

	# ambil soal sekarang
	soal_sekarang = soal_aktif[index_soal]

	# tampilkan pertanyaan
	label_pertanyaan.text = soal_sekarang[\"pertanyaan\"]

	# ambil pilihan
	var pilihan = soal_sekarang[\"pilihan\"].duplicate()

	# acak pilihan
	pilihan.shuffle()

	# list tombol
	var tombol = [jawaban1, jawaban2, jawaban3]

	# =========================
	# RESET TOTAL SEMUA TOMBOL
	# =========================
	for tombol_jawaban in tombol:

		tombol_jawaban.visible = true
		tombol_jawaban.disabled = false

		# reset transparansi
		tombol_jawaban.modulate = Color(1,1,1,1)

		# reset posisi
		tombol_jawaban.position = posisi_awal_tombol[tombol_jawaban]

		# reset ukuran
		tombol_jawaban.scale = Vector2(0.8,0.8)

		# reset rotasi
		tombol_jawaban.rotation_degrees = 0

	# =========================
	# PASANG DATA BARU
	# =========================
	for i in range(3):

		var tombol_jawaban = tombol[i]

		tombol_jawaban.texture_normal = load(
			\"res://balonfathah/%d.png\" % pilihan[i]
		)

		tombol_jawaban.set_meta(
			\"jawaban\",
			pilihan[i]
		)# =========================
# CEK JAWABAN
# =========================

func cek_jawaban(tombol):

	var jawaban = tombol.get_meta(\"jawaban\")

	# jawaban benar
	if jawaban == soal_sekarang[\"jawaban_benar\"]:

		efek_benar(tombol)

		# tunggu animasi
		await get_tree().create_timer(0.35).timeout
		
		# reset tombol yang tadi dipilih
		tombol.modulate = Color(1,1,1,1)
		tombol.position = posisi_awal_tombol[tombol]

		# pindah soal
		index_soal += 1

		# masih ada soal
		if index_soal < soal_aktif.size():

			tampilkan_soal()

		else:

			Global.fathah_selesai = true
			Global.level_terbuka = 2

			popup.show()

	# jawaban salah
	else:

			efek_salah(tombol)
# =========================
# ANIMASI GOYANG / MELAYANG
# =========================

func animasi_goyang(node):

	while true:

		# ambil posisi TERBARU
		var posisi_awal = posisi_awal_tombol[node]

		# delay random supaya tidak barengan
		await get_tree().create_timer(
			randf_range(0.2, 1.0)
		).timeout

		# gerakan random
		var tinggi = randf_range(15.0, 35.0)
		var geser = randf_range(-15.0, 15.0)
		var sudut = randf_range(-6.0, 6.0)
		var durasi = randf_range(1.0, 2.0)

		# naik
		var tween = create_tween()

		tween.parallel().tween_property(
			node,
			\"position\",
			posisi_awal + Vector2(geser, -tinggi),
			durasi
		).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)

		tween.parallel().tween_property(
			node,
			\"rotation_degrees\",
			sudut,
			durasi
		).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)

		await tween.finished

		# turun
		var tween2 = create_tween()

		tween2.parallel().tween_property(
			node,
			\"position\",
			posisi_awal,
			durasi
		).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)

		tween2.parallel().tween_property(
			node,
			\"rotation_degrees\",
			-sudut,
			durasi
		).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)

		await tween2.finished


# =========================
# EFEK SALAH
# =========================

func efek_salah(node):

	var posisi_awal = node.position

	var tween = create_tween()

	tween.tween_property(
		node,
		\"position\",
		posisi_awal + Vector2(-15, 0),
		0.05
	)

	tween.tween_property(
		node,
		\"position\",
		posisi_awal + Vector2(15, 0),
		0.05
	)

	tween.tween_property(
		node,
		\"position\",
		posisi_awal,
		0.05
	)


# =========================
# EFEK BENAR
# =========================

func efek_benar(node):

	var posisi_awal = node.position

	var tween = create_tween()

	tween.parallel().tween_property(
		node,
		\"position\",
		posisi_awal + Vector2(0, -150),
		0.3
	)

	tween.parallel().tween_property(
		node,
		\"modulate:a\",
		0.0,
		0.3
	)
"

[sub_resource type="GDScript" id="GDScript_hprak"]
resource_name = "kembali"
script/source = "extends TextureButton


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	connect(\"pressed\", Callable(self, \"_on_button_pressed\")) # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _on_button_pressed() -> void:
	get_tree().change_scene_to_file(\"res://pilihlevel.tscn\")
"

