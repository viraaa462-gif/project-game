	posisi_awal_tombol[jawaban2] = Vector2(700, 220)
	posisi_awal_tombol[jawaban3] = Vector2(1010, 220)

	# =========================
	# UKURAN BALON LEBIH BESAR
	# =========================

	jawaban1.scale = Vector2(1.8, 1.8)
	jawaban2.scale = Vector2(1.8, 1.8)
	jawaban3.scale = Vector2(1.8, 1.8)
		
	if Global.level_aktif == 1:

		folder_gambar = \"res://balonfathah/\"
		folder_audio = \"res://suarafathah/\"
		audio_soal.volume_db = 5
		audio_benar.volume_db = 4

	elif Global.level_aktif == 2:

		folder_gambar = \"res://balonkasrah/\"
		folder_audio = \"res://suarakasrah/\"
		audio_soal.volume_db = 10
		audio_benar.volume_db = 4

	elif Global.level_aktif == 3:

		folder_gambar = \"res://balondhammah/\"
		folder_audio = \"res://suaradhammah/\"
		audio_soal.volume_db = 5
		audio_benar.volume_db = 4
		
	elif Global.level_aktif == 4:

		folder_gambar = \"res://balonfathatain/\"
		folder_audio = \"res://suarafathatain/\"
		audio_soal.volume_db = 5
		audio_benar.volume_db = 4
		
	elif Global.level_aktif == 5:

		folder_gambar = \"res://balonkasratain/\"
		folder_audio = \"res://suarakasratain/\"
		audio_soal.volume_db = 5
		audio_benar.volume_db = 4
		
	elif Global.level_aktif == 6:

		folder_gambar = \"res://balondhammatain/\"
		folder_audio = \"res://suaradhammatain/\"
		audio_soal.volume_db = 5
		audio_benar.volume_db = 4

	# =========================
	# PILIH SOAL BERDASARKAN LEVEL
	# =========================

	if Global.level_aktif == 1:

		soal_fathah.shuffle()
		soal_aktif = soal_fathah.slice(0, 5)

	elif Global.level_aktif == 2:

		soal_kasrah.shuffle()
		soal_aktif = soal_kasrah.slice(0, 5)

	elif Global.level_aktif == 3:

		soal_dhammah.shuffle()
		soal_aktif = soal_dhammah.slice(0, 5)
		
	elif Global.level_aktif == 4:

		soal_fathatain.shuffle()
		soal_aktif = soal_fathatain.slice(0, 5)
	
	elif Global.level_aktif == 5:

		soal_kasratain.shuffle()
		soal_aktif = soal_kasratain.slice(0, 5)
		
	elif Global.level_aktif == 6:

		soal_dhammatain.shuffle()
		soal_aktif = soal_dhammatain.slice(0, 5)

	# connect tombol
	jawaban1.pressed.connect(func():
		cek_jawaban(jawaban1)
	)

	jawaban2.pressed.connect(func():
		cek_jawaban(jawaban2)
	)

	jawaban3.pressed.connect(func():
		cek_jawaban(jawaban3)
		)
		
	# =========================
	# POSISI PERTANYAAN
	# =========================

