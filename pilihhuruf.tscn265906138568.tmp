	# center di popup
	gambarfeedback.anchor_left = 0.5
	gambarfeedback.anchor_right = 0.5
	gambarfeedback.anchor_top = 0.5
	gambarfeedback.anchor_bottom = 0.5

	gambarfeedback.offset_left = -150
	gambarfeedback.offset_right = 150
	gambarfeedback.offset_top = -150
	gambarfeedback.offset_bottom = 150
	
	
	jawaban1.anchor_left = 0
	jawaban1.anchor_top = 0
