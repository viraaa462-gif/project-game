	popuphasilgame.z_index = 100

	popuphasilgame.anchor_left = 0
	popuphasilgame.anchor_top = 0
	popuphasilgame.anchor_right = 1
	popuphasilgame.anchor_bottom = 1

	popuphasilgame.offset_left = 0
	popuphasilgame.offset_top = 0
	popuphasilgame.offset_right = 0
	popuphasilgame.offset_bottom = 0

	# =========================
	# TOMBOL KEMBALI DAN LANJUT
	# =========================

	btnkembali.texture_normal = load(\"res://uipopupgame/kembali.png\")
	btnlanjut.texture_normal = load(\"res://uipopupgame/lanjut.png\")

	btnkembali.ignore_texture_size = true
	btnlanjut.ignore_texture_size = true

	btnkembali.stretch_mode = TextureButton.STRETCH_SCALE
	btnlanjut.stretch_mode = TextureButton.STRETCH_SCALE

	# ukuran tombol dibuat sama
	var ukuran_tombol = Vector2(150, 60)

	btnkembali.size = ukuran_tombol
	btnlanjut.size = ukuran_tombol

	btnkembali.custom_minimum_size = ukuran_tombol
	btnlanjut.custom_minimum_size = ukuran_tombol

	# jangan pakai scale berbeda
	btnkembali.scale = Vector2(1, 1)
	btnlanjut.scale = Vector2(1, 1)

	# posisi sejajar di bawah tulisan
	btnkembali.position = Vector2(460, 450)
	btnlanjut.position = Vector2(660, 450)

	btnkembali.visible = false
	btnlanjut.visible = false

	btnkembali.disabled = false
	btnlanjut.disabled = false

	btnkembali.z_index = 1000
	btnlanjut.z_index = 1000

	btnkembali.mouse_filter = Control.MOUSE_FILTER_STOP
	btnlanjut.mouse_filter = Control.MOUSE_FILTER_STOP

	btnkembali.pressed.connect(_on_btnkembali_pressed)
	btnlanjut.pressed.connect(_on_btnlanjut_pressed)
	
	if label_pertanyaan:
		label_pertanyaan.visible = false
		
		boleh_jawab = false

		jawaban1.disabled = true
		jawaban2.disabled = true
		jawaban3.disabled = true

	tampilkan_soal()
	btn_sound.pressed.connect(_on_btn_sound_pressed)


func _on_btn_sound_pressed():
	putar_suara_soal()

# =========================
# TAMPILKAN SOAL
# =========================

func _process(delta):
	if balon_bergerak == false:
		return

	waktu += delta

	if posisi_awal_tombol.has(jawaban1):
		jawaban1.position.y = posisi_awal_tombol[jawaban1].y + sin(waktu * 2.0) * 8

	if posisi_awal_tombol.has(jawaban2):
		jawaban2.position.y = posisi_awal_tombol[jawaban2].y + sin((waktu + 1.5) * 2.0) * 8

	if posisi_awal_tombol.has(jawaban3):
		jawaban3.position.y = posisi_awal_tombol[jawaban3].y + sin((waktu + 3.0) * 2.0) * 8
		
#func putar_suara_soal():
	#var id_suara = soal_sekarang[\"jawaban_benar\"]
	#var path_audio = folder_audio + str(id_suara) + \".mp3\"

	#audio_soal.stream = load(path_audio)
	#audio_soal.stop()
	#audio_soal.play()
	
func putar_suara_soal():

	boleh_jawab = false

	# disable tombol sementara
	jawaban1.disabled = true
	jawaban2.disabled = true
	jawaban3.disabled = true

	var id_suara = soal_sekarang[\"jawaban_benar\"]
	var path_audio = folder_audio + str(id_suara) + \".mp3\"

	audio_soal.stream = load(path_audio)
	audio_soal.stop()
	audio_soal.play()

	# tunggu audio selesai
	await audio_soal.finished

	boleh_jawab = true

	# aktifkan tombol lagi
	jawaban1.disabled = false
	jawaban2.disabled = false
	jawaban3.disabled = false
		
func tampilkan_soal():

	# ambil soal sekarang
	soal_sekarang = soal_aktif[index_soal]

	# tampilkan pertanyaan
	label_pertanyaan.text = soal_sekarang[\"pertanyaan\"]
	
	await putar_suara_soal()
		
# =========================
# CEK JAWABAN
# =========================
func cek_jawaban(tombol):

	var jawaban = tombol.get_meta(\"jawaban\")

	# =========================
	# JAWABAN BENAR
	# =========================

	if jawaban == soal_sekarang[\"jawaban_benar\"]:
		jumlah_benar += 1
		
		audio_efek.stream = load(\"res://efekbalon/benar.mp3\")
		audio_efek.play()
		
		balon_bergerak = false

		# disable semua tombol
		jawaban1.disabled = true
		jawaban2.disabled = true
		jawaban3.disabled = true

		# animasi balon
		efek_benar(tombol)

		# tunggu animasi
		await get_tree().create_timer(0.35).timeout

		# =========================
		# RANDOM FEEDBACK
		# =========================
		var feedback = feedback_data.pick_random()

		gambarfeedback.texture = load(feedback[\"gambar\"])

		audio_soal.stop()

		audio_benar.stream = load(feedback[\"audio\"])
		audio_benar.stop()
		audio_benar.play()

		# tampilkan popup
		popup_feedback.visible = true

		# tunggu popup
		await get_tree().create_timer(1.5).timeout

		popup_feedback.visible = false

		# reset tombol
		tombol.modulate = Color(1,1,1,1)
		tombol.position = posisi_awal_tombol[tombol]

		# lanjut soal
		index_soal += 1

		# =========================
		# SOAL BERIKUTNYA
		# =========================

		if index_soal < soal_aktif.size():

			tampilkan_soal()

			jawaban1.disabled = false
			jawaban2.disabled = false
			jawaban3.disabled = false
			
			balon_bergerak = true

		else:

			if Global.level_aktif == 1:

				Global.fathah_selesai = true
				Global.level_terbuka = 2

			elif Global.level_aktif == 2:

				Global.kasroh_selesai = true
				Global.level_terbuka = 3

			elif Global.level_aktif == 3:

				Global.dhammah_selesai = true
				Global.level_terbuka = 4

			elif Global.level_aktif == 4:

				Global.fathatain_selesai = true
				Global.level_terbuka = 5

			elif Global.level_aktif == 5:

				Global.kasratain_selesai = true
				Global.level_terbuka = 6

			tampilkan_popuphasilgame()


	# =========================
	# JAWABAN SALAH
	# =========================

	else:

		jumlah_salah += 1

		# efek suara salah
		audio_efek.stream = load(\"res://efekbalon/salah.mp3\")
		audio_efek.play()

		# daftar feedback suara salah
		var daftar_suara_salah = [
				\"res://audiofeedbacksalahbalon/Belumberhasil.mp3\",
				\"res://audiofeedbacksalahbalon/BelumTepat2.mp3\",
				\"res://audiofeedbacksalahbalon/cobalagi.mp3\",
				\"res://audiofeedbacksalahbalon/hmbelumcocoknih.mp3\",
				\"res://audiofeedbacksalahbalon/ittspilihlagiyuk2.mp3\",
				\"res://audiofeedbacksalahbalon/sedikitlagi.mp3\",
				\"res://audiofeedbacksalahbalon/wahbelumcocoknih.mp3\",
				\"res://audiofeedbacksalahbalon/yukcobalagi.mp3\"
		]

		# tunggu efek suara dulu
		await get_tree().create_timer(0.25).timeout

		# putar feedback salah
		audio_salah.stream = load(daftar_suara_salah.pick_random())
		audio_salah.stop()
		audio_salah.play()

		efek_salah(tombol)
		
		# tunggu feedback selesai
		await audio_salah.finished

		# putar ulang suara pertanyaan
		await putar_suara_soal()

# =========================
# EFEK SALAH
# =========================

func efek_salah(node):

	var posisi_awal = node.position

	var tween = create_tween()

	tween.tween_property(
		node,
		\"position\",
		posisi_awal + Vector2(-15, 0),
		0.05
	)

	tween.tween_property(
		node,
		\"position\",
		posisi_awal + Vector2(15, 0),
		0.05
	)

	tween.tween_property(
		node,
		\"position\",
		posisi_awal,
		0.05
	)


# =========================
# EFEK BENAR
# =========================

func efek_benar(node):

	var posisi_awal = node.position

	var tween = create_tween()

	tween.parallel().tween_property(
		node,
		\"position\",
		posisi_awal + Vector2(0, -150),
		0.3
	)

	tween.parallel().tween_property(
		node,
		\"modulate:a\",
		0.0,
		0.3
	)
	
func hitung_jumlah_bintang():
	if jumlah_salah == 0:
		return 3
	elif jumlah_salah <= 2:
		return 2
	else:
		return 1

func tampilkan_bintang_satu_persatu(jumlah):
	var daftar_bintang = [bintang1, bintang2, bintang3]

	star_container.visible = true
	star_container.z_index = 900
	star_container.move_to_front()

	for bintang in daftar_bintang:
		bintang.visible = false
		bintang.scale = Vector2(0.2, 0.2)
		bintang.modulate = Color(1, 1, 1, 1)

	for i in range(jumlah):
		await get_tree().create_timer(0.35).timeout
		
		# =========================
		# SUARA BINTANG
		# =========================
		audio_bintang.stream = load(\"res://audiobintang/BintangMuncul.mp3\")
		audio_bintang.stop()
		audio_bintang.play()

		var bintang = daftar_bintang[i]
		bintang.visible = true
		bintang.z_index = 950
		bintang.move_to_front()

		var tween = create_tween()
		tween.tween_property(
			bintang,
			\"scale\",
			Vector2(1, 1),
			0.25
		).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)


func tampilkan_popuphasilgame():
	balon_bergerak = false
	$judul.visible = false

	audio_soal.stop()
	audio_benar.stop()

	papanhuruf.visible = false
	jawaban1.visible = false
	jawaban2.visible = false
	jawaban3.visible = false

	popup_feedback.visible = false

	bgpopup.texture = load(popuphasil_data.pick_random())

	popuphasilgame.visible = true
	popuphasilgame.z_index = 100
	popuphasilgame.mouse_filter = Control.MOUSE_FILTER_IGNORE

	bgpopup.visible = true
	bgpopup.z_index = 100
	bgpopup.mouse_filter = Control.MOUSE_FILTER_IGNORE
	# =========================
	# POSISI BINTANG
	# =========================

	star_container.visible = true

	# reset anchor ke kiri atas
	star_container.anchor_left = 0
	star_container.anchor_top = 0
	star_container.anchor_right = 0
	star_container.anchor_bottom = 0

	# ukuran container
	star_container.size = Vector2(420, 120)
	star_container.custom_minimum_size = Vector2(420, 120)

	# posisi di dalam popup
	star_container.position = Vector2(70, 35)

	# center isi bintang
	star_container.alignment = BoxContainer.ALIGNMENT_CENTER
	star_container.add_theme_constant_override(\"separation\", 20)

	star_container.z_index = 900
	star_container.mouse_filter = Control.MOUSE_FILTER_IGNORE
	star_container.alignment = BoxContainer.ALIGNMENT_CENTER
	star_container.add_theme_constant_override(\"separation\", 20)

	bintang1.texture = load(\"res://uipopupgame/bintang.png\")
	bintang2.texture = load(\"res://uipopupgame/bintang.png\")
	bintang3.texture = load(\"res://uipopupgame/bintang.png\")

	bintang1.custom_minimum_size = Vector2(120, 120)
	bintang2.custom_minimum_size = Vector2(120, 120)
	bintang3.custom_minimum_size = Vector2(120, 120)

	bintang1.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	bintang2.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	bintang3.expand_mode = TextureRect.EXPAND_IGNORE_SIZE

	bintang1.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	bintang2.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	bintang3.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED

	bintang1.mouse_filter = Control.MOUSE_FILTER_IGNORE
	bintang2.mouse_filter = Control.MOUSE_FILTER_IGNORE
	bintang3.mouse_filter = Control.MOUSE_FILTER_IGNORE

	btnkembali.visible = true
	btnlanjut.visible = true

	btnkembali.disabled = false
	btnlanjut.disabled = false

	btnkembali.mouse_filter = Control.MOUSE_FILTER_STOP
	btnlanjut.mouse_filter = Control.MOUSE_FILTER_STOP

	btnkembali.z_index = 1000
	btnlanjut.z_index = 1000

	var jumlah_bintang = hitung_jumlah_bintang()
	await tampilkan_bintang_satu_persatu(jumlah_bintang)

	btnkembali.move_to_front()
	btnlanjut.move_to_front()
		
func _on_btnkembali_pressed():
	MusikManager.set_volume(0)
	get_tree().change_scene_to_file(\"res://pilihlevel.tscn\")
	
func _on_btnlanjut_pressed():

	MusikManager.set_volume(0)

	# naik level
	Global.level_aktif += 1

	# kalau sudah selesai semua level
	if Global.level_aktif > 6:
		get_tree().change_scene_to_file(\"res://pilihlevel.tscn\")
		return

	# reset tampilan popup
	popuphasilgame.visible = false

	# tampilkan lagi papan permainan
	papanhuruf.visible = true
	$judul.visible = true

	# reset skor
	jumlah_benar = 0
	jumlah_salah = 0

	# reset index soal
	index_soal = 0

	# kosongkan soal lama
	soal_aktif.clear()

	# =========================
	# GANTI LEVEL 2
	# =========================

	if Global.level_aktif == 2:

		folder_gambar = \"res://balonkasrah/\"
		folder_audio = \"res://suarakasrah/\"

		soal_kasrah.shuffle()
		soal_aktif = soal_kasrah.slice(0, 5)
		
		
	# =========================
	# LEVEL 4 = FATHATAIN 3
	# =========================
	elif Global.level_aktif == 3:

		folder_gambar = \"res://balondhammah/\"
		folder_audio = \"res://suaradhammah/\"

		soal_dhammah.shuffle()
		soal_aktif = soal_dhammah.slice(0, 5)
	
	# =========================
	# LEVEL 4 = FATHATAIN
	# =========================
	elif Global.level_aktif == 4:

		folder_gambar = \"res://balonfathatain/\"
		folder_audio = \"res://suarafathatain/\"

		soal_fathatain.shuffle()
		soal_aktif = soal_fathatain.slice(0, 5)

	# =========================
	# LEVEL 5 = KASRATAIN
	# =========================
	elif Global.level_aktif == 5:

		folder_gambar = \"res://balonkasratain/\"
		folder_audio = \"res://suarakasratain/\"

		soal_kasratain.shuffle()
		soal_aktif = soal_kasratain.slice(0, 5)

	# =========================
	# LEVEL 6 = DHAMMATAIN
	# =========================
	elif Global.level_aktif == 6:

		folder_gambar = \"res://balondhammatain/\"
		folder_audio = \"res://suaradhammatain/\"

		soal_dhammatain.shuffle()
		soal_aktif = soal_dhammatain.slice(0, 5)


	# aktifkan gerakan lagi
	balon_bergerak = true

		# aktifkan gerakan lagi
	balon_bergerak = true

	# kecilkan musik lagi
	MusikManager.set_volume(-27)

	# tampilkan soal baru
	tampilkan_soal()
"

[sub_resource type="GDScript" id="GDScript_hprak"]
resource_name = "kembali"
script/source = "extends TextureButton


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	connect(\"pressed\", Callable(self, \"_on_button_pressed\")) # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _on_button_pressed() -> void:
	get_tree().change_scene_to_file(\"res://pilihlevel.tscn\")
"

