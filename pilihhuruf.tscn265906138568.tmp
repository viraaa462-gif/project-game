	popup_feedback.anchor_left = 0.5
	popup_feedback.anchor_right = 0.5
	popup_feedback.anchor_top = 0.5
	popup_feedback.anchor_bottom = 0.5

	# ukuran popup sedikit lebih kecil
	popup_feedback.offset_left = -180
	popup_feedback.offset_right = 180
	popup_feedback.offset_top = -80
	popup_feedback.offset_bottom = 240
	
