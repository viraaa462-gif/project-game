resource_name = "pilihhuruf"
script/source = "extends Control

# =========================
# VARIABLE
# =========================

var soal_aktif = []
var index_soal = 0
var soal_sekarang

# simpan posisi awal tombol
var posisi_awal_tombol = {}

# =========================
# NODE
# =========================

@onready var label_pertanyaan = $papanhuruf/header/Label

@onready var jawaban1 = $papanhuruf/pilihanhuruf/jawaban1
@onready var jawaban2 = $papanhuruf/pilihanhuruf/jawaban2
@onready var jawaban3 = $papanhuruf/pilihanhuruf/jawaban3


# =========================
# DATA SOAL
# =========================

var semua_soal = [

	{
		\"pertanyaan\": \"huruf manakah yang dibaca A\",
		\"jawaban_benar\": 1,
		\"pilihan\": [1, 3, 5]
	},

	{
