		\"pilihan\": [9, 12, 15]
	},

	{
		\"pertanyaan\": \"huruf manakah yang dibaca Ro\",
		\"jawaban_benar\": 10,
		\"pilihan\": [10, 13, 16]
	},

	{
		\"pertanyaan\": \"huruf manakah yang dibaca Za\",
		\"jawaban_benar\": 11,
		\"pilihan\": [11, 14, 17]
	},

	{
		\"pertanyaan\": \"huruf manakah yang dibaca Sa\",
		\"jawaban_benar\": 12,
		\"pilihan\": [12, 15, 18]
	},

	{
		\"pertanyaan\": \"huruf manakah yang dibaca Sya\",
		\"jawaban_benar\": 13,
		\"pilihan\": [13, 16, 19]
	},

	{
