	},

	{
		\"pertanyaan\": \"huruf manakah yang dibaca Zho\",
		\"jawaban_benar\": 17,
		\"pilihan\": [17, 20, 23]
	},

	{
		\"pertanyaan\": \"huruf manakah yang dibaca 'aa\",
		\"jawaban_benar\": 18,
		\"pilihan\": [18, 21, 24]
