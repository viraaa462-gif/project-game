# =========================
# READY
# =========================

func _ready():

	randomize()

	# simpan posisi awal
# simpan posisi baru
	posisi_awal_tombol[jawaban1] = Vector2(300, 70)
	posisi_awal_tombol[jawaban2] = Vector2(610, 70)
	posisi_awal_tombol[jawaban3] = Vector2(920, 70)
			
	jawaban1.scale = Vector2(0.8, 0.8)
	jawaban2.scale = Vector2(0.8, 0.8)
	jawaban3.scale = Vector2(0.8, 0.8)


	# acak semua soal
	semua_soal.shuffle()

	# ambil 5 soal
	soal_aktif = semua_soal.slice(0, 5)

	# connect tombol
	jawaban1.pressed.connect(func():
		cek_jawaban(jawaban1)
	)

	jawaban2.pressed.connect(func():
		cek_jawaban(jawaban2)
	)

	jawaban3.pressed.connect(func():
		cek_jawaban(jawaban3)
	)

	# animasi goyang
	animasi_goyang(jawaban1)
	animasi_goyang(jawaban2)
	animasi_goyang(jawaban3)

	tampilkan_soal()

# =========================
# TAMPILKAN SOAL
# =========================

func tampilkan_soal():

	# ambil soal sekarang
	soal_sekarang = soal_aktif[index_soal]

	# tampilkan pertanyaan
	label_pertanyaan.text = soal_sekarang[\"pertanyaan\"]

	# ambil pilihan
	var pilihan = soal_sekarang[\"pilihan\"].duplicate()

	# acak pilihan
	pilihan.shuffle()

	# list tombol
	var tombol = [jawaban1, jawaban2, jawaban3]

	# reset semua tombol
	for tombol_jawaban in tombol:

		tombol_jawaban.visible = true
		tombol_jawaban.disabled = false

		tombol_jawaban.scale = Vector2(0.8,0.8)

		tombol_jawaban.modulate = Color(1,1,1,1)

		# reset posisi ke posisi awal
		tombol_jawaban.position = posisi_awal_tombol[tombol_jawaban]

	# pasang data baru
	for i in range(3):

		var tombol_jawaban = tombol[i]

		tombol_jawaban.texture_normal = load(
			\"res://balonfathah/%d.png\" % pilihan[i]
		)

		tombol_jawaban.set_meta(
			\"jawaban\",
			pilihan[i]
		)

# =========================
# CEK JAWABAN
# =========================

func cek_jawaban(tombol):

	var jawaban = tombol.get_meta(\"jawaban\")

	# jawaban benar
	if jawaban == soal_sekarang[\"jawaban_benar\"]:

		efek_benar(tombol)

		# tunggu animasi
		await get_tree().create_timer(0.3).timeout

		# pindah soal
		index_soal += 1

		# masih ada soal
		if index_soal < soal_aktif.size():

			tampilkan_soal()

		else:

			print(\"SELESAI\")

	# jawaban salah
	else:

		efek_salah(tombol)

# =========================
# ANIMASI GOYANG
# =========================

func animasi_goyang(node):

	var tween = create_tween()

	tween.set_loops()

	tween.tween_property(
		node,
		\"rotation_degrees\",
		2,
		1.5
	).set_trans(Tween.TRANS_SINE)

	tween.tween_property(
		node,
		\"rotation_degrees\",
		-2,
		1.5
	).set_trans(Tween.TRANS_SINE)

# =========================
# EFEK SALAH
# =========================

func efek_salah(node):

	var posisi_awal = node.position

	var tween = create_tween()

	tween.tween_property(
		node,
		\"position\",
		posisi_awal + Vector2(-10, 0),
		0.05
	)

	tween.tween_property(
		node,
		\"position\",
		posisi_awal + Vector2(10, 0),
		0.05
	)

	tween.tween_property(
		node,
		\"position\",
		posisi_awal,
		0.05
	)

# =========================
# EFEK BENAR
# =========================

func efek_benar(node):

	var posisi_awal = node.position

	var tween = create_tween()

	tween.parallel().tween_property(
		node,
		\"position\",
		posisi_awal + Vector2(0, -150),
		0.3
	)

	tween.parallel().tween_property(
		node,
		\"modulate:a\",
		0.0,
		0.3
	)

func kecilkan_balon(node):

	node.scale = Vector2(0.55, 0.55)

	node.custom_minimum_size = Vector2.ZERO

	node.size = Vector2(120, 120)
"

[sub_resource type="GDScript" id="GDScript_hprak"]
resource_name = "kembali"
script/source = "extends TextureButton


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	connect(\"pressed\", Callable(self, \"_on_button_pressed\")) # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _on_button_pressed() -> void:
	get_tree().change_scene_to_file(\"res://pilihlevel.tscn\")
"

