[sub_resource type="GDScript" id="GDScript_c8184"]
resource_name = "res://Splashscreen"
script/source = "extends Control

@onready var loading_bar = $loading
@onready var loading_text = get_node(\"Label\")

var load_value := 0.0
var speed := 22.0
var dot_timer := 0.0
var dot_count := 0

func _process(delta):
	if load_value < 100:
		load_value += speed * delta
		loading_bar.value = load_value
	else:
		await get_tree().create_timer(0.5).timeout
		get_tree().change_scene_to_file(\"res://menu_utama.tscn\")

	dot_timer += delta
	if dot_timer >= 0.5:
		dot_timer = 0
		dot_count = (dot_count + 1) % 4
		loading_text.text = \"Ayo Belajar Huruf\" + \".\".repeat(dot_count)
"

